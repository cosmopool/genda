# genda environment. Copy to .env, fill in, then:
#   set -a; . ./.env; set +a; ./genda
# Commented lines show the default used when the variable is unset.

# --- Required -------------------------------------------------------------

# OpenCode Zen API key (opencode.ai/zen). genda exits 1 without it.
OPENCODE_API_KEY=

# --- Server ---------------------------------------------------------------

# Listen port (loopback only; put Caddy/Tailscale in front for TLS).
# GENDA_PORT=8080

# SQLite file, created if missing.
# GENDA_DB=./genda.db

# Bearer token for /ingest and /events. Empty = open (no auth).
# GENDA_TOKEN=

# --- Classifier (Jev via OpenCode Zen System One) -------------------------

# GENDA_ZEN_URL=https://opencode.ai/zen/v1/systemone
# Free while the promo lasts; switch to jev-1.13 when it ends.
# GENDA_ZEN_MODEL=jev-1.13-free

# --- IMAP poller (off unless GENDA_IMAP_URL is set) -----------------------

# GENDA_IMAP_URL=imaps://mail.example.com/INBOX
# GENDA_IMAP_USER=
# GENDA_IMAP_PASS=
# Seconds between polls (min 60).
# GENDA_IMAP_POLL_SEC=300
